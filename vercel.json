{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/guest",
   "destination": "/index.html"
  }
 ],
 "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)pubav.js'",
 "git": {
  "deploymentEnabled": {
   "data": false
  }
 }
}